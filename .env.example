# .env.example — placeholder shape for this product's secrets.
# Copy this file to .env (never commit .env) and fill in real values.
# See docs/secret-convention.md for rules on which secrets live where.
# TODO: review once the-wip and 24-hours-of-power are compared.

# ── Core service (example — rename per product) ─────────────────────────────
EXAMPLE_API_TOKEN=
EXAMPLE_API_URL=

# ── Object storage (example — Cloudflare R2 / S3) ───────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# ── Database (example — Supabase / Postgres) ────────────────────────────────
DATABASE_URL=
DATABASE_POOL_URL=

# ── Logging / observability ─────────────────────────────────────────────────
BETTERSTACK_SOURCE_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── App-generated secrets (run: openssl rand -hex 32) ───────────────────────
IP_HASH_KEY=
HISTORY_COOKIE_KEY=

# ── Transactional email (example — Resend) ──────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ── Payments (example — Stripe) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Bot protection (example — hCaptcha) ─────────────────────────────────────
HCAPTCHA_SECRET_KEY=

# ── Web (browser-visible, build-time) ───────────────────────────────────────
# NEXT_PUBLIC_* values are shipped to the browser. Never put a real secret here.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
